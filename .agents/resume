#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.local/share/axiom-orb/node/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

# Snapshots retain tools and dependencies. Resume only checks readiness; it never installs or authenticates.
for tool in node bun cargo fd rg; do
	command -v "$tool" >/dev/null
done
printf 'Axiom orb ready: Node %s, Bun %s\n' "$(node --version)" "$(bun --version)"
